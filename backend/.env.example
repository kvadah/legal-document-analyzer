# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_doc_analyzer

# ---- Redis (cache, Arq queue, SSE pub/sub, rate limiting) ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant (vector store) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# ---- Object storage (S3-compatible / MinIO) ----
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=legal-doc-analyzer
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=/tmp/legal-doc-storage

# ---- LLM providers ----
DEFAULT_LLM_PROVIDER=anthropic       # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
MOCK_LLM=true                        # true => deterministic heuristic responses (fast, free local dev)

# ---- Embeddings (Gemini API) ----
MOCK_EMBEDDINGS=true
GEMINI_API_KEY=
EMBEDDING_MODEL_NAME=gemini-embedding-001

# ---- Auth / JWT ----
JWT_SECRET_KEY=change-me-in-production

# ---- Uploads / pipelines ----
MAX_UPLOAD_MB=50
RUN_INGESTION_INLINE=false
RUN_AI_PIPELINE_INLINE=false
