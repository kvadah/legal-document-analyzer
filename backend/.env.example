# ---- Application ----
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=info
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://lda:lda@localhost:5432/lda

# ---- Redis (cache, Arq queue, SSE pub/sub, rate limiting) ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant (vector store) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# ---- Object storage (S3-compatible / MinIO) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=legal-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# ---- LLM providers ----
LLM_PRIMARY_PROVIDER=anthropic     # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model ids are config-swappable per task tier. Verify current ids for your account.
LLM_FAST_MODEL=claude-3-5-haiku-latest       # tier: "fast"    (entity extraction, light classification)
LLM_CAPABLE_MODEL=claude-3-5-sonnet-latest   # tier: "capable" (clauses, risk, summary, RAG)
MOCK_LLM=false                     # true => canned structured responses (fast, free local dev)

# ---- Embeddings / reranker ----
EMBEDDING_PROVIDER=bge             # bge | openai
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- OCR / parsing ----
OCR_ENGINE=paddleocr               # paddleocr | tesseract
OCR_CONFIDENCE_WARN_THRESHOLD=0.70

# ---- Auth / JWT ----
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=50

# ---- Observability ----
SENTRY_DSN=
