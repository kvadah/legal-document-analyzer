FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for OCR and document processing
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    tesseract-ocr \
    poppler-utils \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first — this layer is cached unless
# pyproject.toml changes, so code edits never trigger a full re-download.
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 600 --retries 20 \
    $(python -c "import tomllib; p=tomllib.load(open('pyproject.toml','rb'))['project']; print(' '.join(p['dependencies'] + p['optional-dependencies']['processing']))")

# Copy application code (only layers from here on rebuild on code changes)
COPY . .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --timeout 600 --retries 20 ".[processing]"

# Create non-root user
RUN useradd -m -u 1000 appuser
USER appuser

# Run the Arq worker
CMD ["arq", "app.workers.jobs.WorkerSettings"]
