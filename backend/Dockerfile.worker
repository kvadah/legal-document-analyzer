FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for OCR and document processing
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    tesseract-ocr \
    poppler-utils \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (including processing extras)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[processing]"

# Copy application code
COPY . .

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Run the Arq worker
CMD ["arq", "app.workers.jobs.WorkerSettings"]
