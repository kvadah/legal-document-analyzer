FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for OCR and document processing
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    tesseract-ocr \
    poppler-utils \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Copy application code and install dependencies (including processing extras)
COPY . .
RUN pip install --no-cache-dir --timeout 600 --retries 20 ".[processing]"

# Create non-root user
RUN useradd -m -u 1000 appuser
USER appuser

# Run the Arq worker
CMD ["arq", "app.workers.jobs.WorkerSettings"]
