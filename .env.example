# ─────────────────────────────────────────────────────────────────────────────
# Legal Doc AI — environment configuration
#
# Copy to `.env` (same directory) before starting the stack:
#   cp .env.example .env
#
# Docker Compose reads this file automatically for variable interpolation.
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────────────
# One of: gemini | anthropic | openai
DEFAULT_LLM_PROVIDER=gemini

# API key for the chosen provider (only the matching one is required)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gemini model names — use the gemini-3.x family (gemini-2.5-* is unavailable
# to recently-created keys). Split: a capable model for clause/risk/summary
# extraction, a fast one for lighter tasks.
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_LLM_FAST_MODEL=gemini-3.5-flash-lite

# Seconds between LLM calls (~10 RPM ≈ free-tier quota pacing). 0 disables.
GEMINI_MIN_REQUEST_INTERVAL=6

# Optional per-request thinking budget for Gemini (empty = provider default)
GEMINI_THINKING_BUDGET=

# ── Keyless mode ─────────────────────────────────────────────────────────────
# Set both to true to run the full pipeline with mock providers — no API keys
# needed (useful for demos, development, and CI).
MOCK_LLM=false
MOCK_EMBEDDINGS=false
